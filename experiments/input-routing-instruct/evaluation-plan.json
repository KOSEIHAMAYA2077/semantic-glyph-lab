          "elongation": 1,
          "twist": 0,
          "bend": 0,
          "roughness": 0,
          "count": 1
        }
      },
      "expected": {
        "action": "new",
        "changes": {
          "count": {
            "equals": 1
          }
        },
        "target": "sphere"
      },
